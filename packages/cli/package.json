{
  "name": "@bee-ui/cli",
  "version": "1.0.0",
  "description": "CLI tool for adding Bee UI components to your project",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "bin": {
    "beeui": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs --dts --out-dir dist",
    "dev": "tsup src/index.ts --format cjs --dts --out-dir dist --watch"
  },
  "dependencies": {
    "@antfu/ni": "^25.0.0",
    "chalk": "^4.1.2",
    "commander": "^11.1.0",
    "execa": "^5.1.1",
    "fs-extra": "^11.3.0",
    "ora": "^5.4.1",
    "prompts": "^2.4.2",
    "zod": "^4.0.14"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^20.10.5",
    "@types/prompts": "^2.4.9",
    "tsup": "^8.5.0",
    "typescript": "^5.3.3"
  },
  "keywords": [
    "cli",
    "react",
    "components",
    "ui",
    "generator"
  ],
  "author": "Bee UI Team",
  "license": "MIT"
}
